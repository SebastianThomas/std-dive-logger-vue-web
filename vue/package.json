{
  "name": "vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:ci": "NODE_OPTIONS=\"--localstorage-file=/tmp/.vitest-localstorage\" vitest --run",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "axios": "^1.21.0",
    "d3": "^7.9.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-json-pretty": "^2.6.0",
    "vue-leaflet-markercluster": "^0.6.1",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/node26": "^26.0.1",
    "@types/d3": "^7.4.3",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/devtools-api": "^8.2.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "~10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.4",
    "prettier": "3.9.10",
    "typescript": "~6.0.0",
    "vite": "^8.3.5",
    "vite-plugin-mkcert": "^2.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "resolutions": {
    "vite": "^8.0.0"
  }
}
